# Neon Postgres connection string (pooled connection recommended)
# Get this from the Neon dashboard after creating a project.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# collegefootballdata.com API key
# Sign up for a free key at https://collegefootballdata.com/key
CFBD_API_KEY=""

# Shared secret required to call POST/GET /api/refresh.
# Generate any random string, e.g.: openssl rand -hex 32
CRON_SECRET=""
